{
  "interface_version": 2,
  "name": "Mecharashi",
  "version": "0.0.1",
  "controller": [
    {
      "name": "桌面端",
      "type": "Win32",
      "win32": {
        "class_regex": ".*",
        "window_regex": ".*(钢岚|Mecharashi).*",
        "screencap": "PrintWindow",
        "mouse": "PostMessageWithCursorPos",
        "keyboard": "PostMessageWithCursorPos"
      }
    },
    {
      "name": "安卓端",
      "type": "Adb",
      "display_short_side": 720
    }
  ],
  "resource": [
    {
      "name": "默认",
      "path": [
        "{PROJECT_DIR}/resource"
      ]
    }
  ],
  "task": [
    {
      "name": "启动游戏",
      "entry": "是否需要启动游戏",
      "default_check": true,
      "option": ["启动游戏"],
      "doc": "从任意界面返回游戏主界面，可选择是否启动游戏"
    },
    {
      "name": "灰烬行动",
      "entry": "灰烬行动开始",
      "default_check": true,
      "doc": "自动处理派遣"
    },
    {
      "name": "使用战术影像",
      "entry": "使用战术影像一次开始",
      "default_check": true,
      "doc": "完成一次战术影像使用任务"
    },
    {
      "name": "刷体力 - 精英战役",
      "entry": "刷体力开始",
      "default_check": true,
      "pipeline_override": {
        "开始选择扩展委托类型": {
          "next": ["精英战役"]
        }
      },
      "doc": "扫荡精英战役，消耗体力"
    },
    {
      "name": "刷体力 - 首领剿灭",
      "entry": "刷体力开始",
      "default_check": true,
      "option": ["刷体力-首领剿灭-选择关卡"],
      "pipeline_override": {
        "开始选择扩展委托类型": {
          "next": ["首领剿灭"]
        }
      },
      "doc": "扫荡首领剿灭，消耗体力"
    },
    {
      "name": "刷体力 - 前线试炼",
      "entry": "刷体力开始",
      "default_check": true,
      "option": ["刷体力-前线试炼-选择关卡"],
      "pipeline_override": {
        "开始选择扩展委托类型": {
          "next": ["前线试炼"]
        }
      },
      "doc": "扫荡前线试炼，消耗体力"
    },
    {
      "name": "刷体力 - 战术模拟",
      "entry": "刷体力开始",
      "default_check": true,
      "option": ["刷体力-战术模拟-芯片演算类型"],
      "pipeline_override": {
        "开始选择扩展委托类型": {
          "next": ["战术模拟"]
        }
      },
      "doc": "扫荡战术模拟，消耗体力"
    },
    {
      "name": "领取日常奖励",
      "entry": "领取日常奖励开始",
      "default_check": true,
      "doc": "自动领取日常合约奖励"
    }
  ],
  "option": {
    "启动游戏": {
      "type": "select",
      "label": "启动方式",
      "default_case": "不需要启动游戏",
      "cases": [
        {
          "name": "不需要启动游戏",
          "label": "不需要启动游戏",
          "pipeline_override": {
            "是否需要启动游戏": {
              "next": ["不需要启动游戏"]
            }
          }
        },
        {
          "name": "需要启动游戏",
          "label": "需要启动游戏",
          "pipeline_override": {
            "是否需要启动游戏": {
              "next": ["需要启动游戏"]
            }
          }
        }
      ]
    },
    "刷体力-首领剿灭-选择关卡": {
      "type": "select",
      "label": "选择关卡",
      "default_case": "灰烬重燃",
      "cases": [
        {
          "name": "灰烬重燃",
          "label": "灰烬重燃",
          "pipeline_override": {
            "首领剿灭选择具体关卡-首领剿灭": {
              "next": [
                "灰烬重燃-首领剿灭",
                "[JumpBack]左侧关卡列表滑动-首领剿灭"
              ]
            }
          }
        },
        {
          "name": "消逝的光芒",
          "label": "消逝的光芒",
          "pipeline_override": {
            "首领剿灭选择具体关卡-首领剿灭": {
              "next": [
                "消逝的光芒-首领剿灭",
                "[JumpBack]左侧关卡列表滑动-首领剿灭"
              ]
            }
          }
        },
        {
          "name": "野蛮生长",
          "label": "野蛮生长",
          "pipeline_override": {
            "首领剿灭选择具体关卡-首领剿灭": {
              "next": [
                "野蛮生长-首领剿灭",
                "[JumpBack]左侧关卡列表滑动-首领剿灭"
              ]
            }
          }
        }
      ]
    },
    "刷体力-前线试炼-选择关卡": {
      "type": "select",
      "label": "关卡类型",
      "default_case": "组件获取",
      "cases": [
        {
          "name": "组件获取",
          "label": "组件获取",
          "option": ["刷体力-前线试炼-组件获取-选择关卡"],
          "pipeline_override": {
            "前线试炼选择具体关卡": {
              "next": ["组件获取"]
            }
          }
        },
        {
          "name": "基体搜寻",
          "label": "基体搜寻",
          "pipeline_override": {
            "前线试炼选择具体关卡": {
              "next": ["基体搜寻"]
            }
          }
        }
      ]
    },
    "刷体力-前线试炼-组件获取-选择关卡": {
      "type": "select",
      "label": "组件获取关卡",
      "default_case": "追歼退却",
      "cases": [
        {
          "name": "追歼退却",
          "label": "追歼退却",
          "pipeline_override": {
            "选择扫荡关卡开始-组件获取": {
              "next": ["追歼退却"]
            }
          }
        },
        {
          "name": "抢滩登陆",
          "label": "抢滩登陆",
          "pipeline_override": {
            "选择扫荡关卡开始-组件获取": {
              "next": ["抢滩登陆"]
            }
          }
        }
      ]
    },
    "刷体力-战术模拟-芯片演算类型": {
      "type": "select",
      "label": "演算类型",
      "default_case": "α芯片演算",
      "cases": [
        {
          "name": "α芯片演算",
          "label": "α芯片演算",
          "option": ["刷体力-战术模拟-选择哪种芯片"],
          "pipeline_override": {
            "选择芯片演算类型-战术模拟": {
              "next": [
                "α芯片演算-战术模拟",
                "[JumpBack]战术模拟选择自动演算-战术模拟_第二次"
              ]
            }
          }
        },
        {
          "name": "β芯片演算",
          "label": "β芯片演算",
          "option": ["刷体力-战术模拟-选择哪种芯片"],
          "pipeline_override": {
            "选择芯片演算类型-战术模拟": {
              "next": [
                "β芯片演算-战术模拟",
                "[JumpBack]战术模拟选择自动演算-战术模拟_第二次"
              ]
            }
          }
        },
        {
          "name": "y芯片演算",
          "label": "y芯片演算",
          "option": ["刷体力-战术模拟-选择哪种芯片"],
          "pipeline_override": {
            "选择芯片演算类型-战术模拟": {
              "next": [
                "y芯片演算-战术模拟",
                "[JumpBack]战术模拟选择自动演算-战术模拟_第二次"
              ]
            }
          }
        },
        {
          "name": "γ+芯片演算",
          "label": "γ+芯片演算",
          "option": ["刷体力-战术模拟-选择哪种芯片"],
          "pipeline_override": {
            "选择芯片演算类型-战术模拟": {
              "next": [
                "γ+芯片演算-战术模拟",
                "[JumpBack]战术模拟选择自动演算-战术模拟_第二次"
              ]
            }
          }
        }
      ]
    },
    "刷体力-战术模拟-选择哪种芯片": {
      "type": "select",
      "label": "芯片颜色",
      "default_case": "红色芯片",
      "cases": [
        {
          "name": "红色芯片",
          "label": "红色芯片",
          "pipeline_override": {
            "开始选择哪种芯片-战术模拟": {
              "next": ["红色芯片-战术模拟"]
            }
          }
        },
        {
          "name": "蓝色芯片",
          "label": "蓝色芯片",
          "pipeline_override": {
            "开始选择哪种芯片-战术模拟": {
              "next": ["蓝色芯片-战术模拟"]
            }
          }
        },
        {
          "name": "黄色芯片",
          "label": "黄色芯片",
          "pipeline_override": {
            "开始选择哪种芯片-战术模拟": {
              "next": ["黄色芯片-战术模拟"]
            }
          }
        }
      ]
    }
  }
}